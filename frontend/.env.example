# Copiar a .env.local y completar los valores.
# IMPORTANTE: nunca subir .env / .env.local a git (ya esta en .gitignore).

# URL base de la API. Si se deja vacia se usa el modo demo (localStorage).
VITE_API_URL=

# Modo demo: 'true' fuerza los datos ficticios aunque exista API.
VITE_DEMO_MODE=true

# Identificador visible de la escuela.
VITE_APP_NAME=ERP Futbol

# Version semantica mostrada en Configuracion.
VITE_APP_VERSION=1.0.0
