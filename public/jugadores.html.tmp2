<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Escuela - Jugadores | EFUSA V7</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>*</text></svg>">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','sans-serif']},colors:{brand:{50:'#ecfdf5',500:'#22c55e',600:'#16a34a',700:'#15803d'}},boxShadow:{card:'0 8px 30px rgba(0,0,0,0.06)'}}}}</script>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>body{font-family:Inter,sans-serif;background:#F1F5F9}</style>
</head>
<body class="min-h-screen text-slate-800">
<div id="nav-container"></div>
<div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-3 pointer-events-none"></div>
<div class="bg-[#7C2D12] text-white">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div>
        <p class="text-[11px] font-black tracking-[0.18em] text-amber-200 uppercase">ESCUELA</p>
        <h1 class="text-2xl md:text-3xl font-black tracking-tight mt-1">Jugadores <span class="text-white/40 font-light">- Directorio vivo</span></h1>
        <div class="flex flex-wrap gap-2 mt-4">
          <span class="text-xs bg-white/10 border border-white/10 px-3 py-1.5 rounded-full">Nino / Nina</span>
          <span class="text-xs bg-white/10 border border-white/10 px-3 py-1.5 rounded-full">Becas 50% / 100%</span>
          <span class="text-xs bg-white/10 border border-white/10 px-3 py-1.5 rounded-full">WhatsApp obligatorio</span>
        </div>
      </div>
      <div class="flex gap-2">
        <button onclick="abrirModal()" class="px-5 py-3 bg-emerald-500 hover:bg-emerald-400 text-white rounded-xl font-black text-sm shadow-lg flex items-center gap-2">
          <i class="ph ph-plus text-lg"></i> Nuevo jugador
        </button>
        <button onclick="document.getElementById(' &apos;buscador&apos;').focus()" class="px-4 py-3 bg-white/10 hover:bg-white/15 border border-white/10 rounded-xl text-sm font-bold">Buscar</button>
      </div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-6">
      <div class="bg-white text-slate-900 rounded-2xl p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-600 text-white flex items-center justify-center"><i class="ph ph-users-three"></i></div>
        <div><p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">TOTAL</p><p id="stat-total" class="text-xl font-black">1</p></div>
      </div>
      <div class="bg-white rounded-2xl p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center"><i class="ph ph-check"></i></div>
        <div><p class="text-[10px] font-black text-slate-400 uppercase">AL DIA</p><p id="stat-pagados" class="text-xl font-black text-emerald-600">1</p></div>
      </div>
      <div class="bg-white rounded-2xl p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center"><i class="ph ph-clock"></i></div>
        <div><p class="text-[10px] font-black text-slate-400 uppercase">ABONO</p><p id="stat-abono" class="text-xl font-black text-amber-600">0</p></div>
      </div>
      <div class="bg-white rounded-2xl p-4 flex items-center gap-3 border-2 border-rose-100">
        <div class="w-10 h-10 rounded-xl bg-rose-500 text-white flex items-center justify-center"><i class="ph ph-warning"></i></div>
        <div><p class="text-[10px] font-black text-rose-400 uppercase">DEBE</p><p id="stat-pendientes" class="text-xl font-black text-rose-600">0</p></div>
      </div>
    </div>
  </div>
</div>
